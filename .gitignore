# Secrets — never commit. .env.example is the tracked template.
# .env.e2e is generated by scripts/e2e.sh on each run and deleted on teardown;
# it holds only throwaway values, but it is still never committed.
.env
.env.*
!.env.example

# Your own infrastructure: real hostnames, LAN addresses, SSH aliases, server
# paths, the app inventory. THIS REPOSITORY IS PUBLIC — nothing in here may be
# committed. local.example/ is the tracked template; see local.example/README.md.
#
# No trailing slash and no negation patterns, deliberately: a slash misses a
# symlink, and one wrong `!` line silently publishes your network layout.
# CI fails the build if anything under local/ is ever tracked.
local

# Python
__pycache__/
*.py[cod]
.venv
.venv-test
.pytest_cache/
*.db

# Node
# No trailing slash, deliberately. DEVELOPING.md tells you to SYMLINK these into
# a worktree (a fresh worktree has no gitignored files), and `node_modules/`
# with a slash matches only a directory -- a symlink stays untracked-but-visible
# and `git add -A` commits a link into your home directory.
node_modules
dist
.next
out

# Test output
playwright-report/
test-results/
coverage/

# Editors / OS
.DS_Store
*.swp

# Claude local settings (settings.json IS tracked; .local.json is not)
.claude/settings.local.json
.claude/worktrees/
