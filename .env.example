# Copy to .env and fill in.  .env is read by the compose CLI ON THE DEV MACHINE
# (both `env_file:` and ${VAR} interpolation) and is NEVER copied to the Pi —
# editing it here and redeploying is enough to change production config.
#
# Every value below must have a safe local default or be clearly marked required,
# so that `docker compose up` works on a fresh clone without a real secret.
#
# `# block:<name>` sections belong to a block (docs/BLOCKS.md) and leave with it.

# --- Application ---
APP_NAME=project-template
# block:web|api
# Public hostname once deployed. Also used by the deploy health check.
PUBLIC_HOST=project-template.example.com
# /block

# --- Local dev ports (host side only) ---
# Change these if something else on your machine already holds the default.
# They affect ONLY what is published to the host: inside the compose network the
# services always talk to `db:5432` and `backend:8000`, so nothing else moves.
#   ss -ltn | grep -E ':5432|:8000|:5173'   # see what is taken
# block:postgres
DEV_DB_PORT=5432
# /block
# block:api
DEV_API_PORT=8000
# /block
# block:web
DEV_WEB_PORT=5173
# /block

# block:postgres
# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=app
# Consumed by the backend. Host `db` is the compose service name.
DATABASE_URL=postgresql+asyncpg://app:change-me-locally@db:5432/app
# /block

# block:api|worker
# --- Backend ---
# REQUIRED in production. Generate: openssl rand -hex 32
SECRET_KEY=dev-only-not-a-real-secret
# /block
# block:worker
# Seconds between worker ticks; its healthcheck fails after three missed.
WORKER_INTERVAL_SECONDS=30
# /block

# --- Third-party (optional; leave blank to disable the feature) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# block:web
# --- Frontend ---
# Baked in at BUILD time by Vite (VITE_* are inlined client-side), so changing
# it requires a rebuild, not a restart. Empty = same-origin /api.
VITE_API_BASE=
# /block
