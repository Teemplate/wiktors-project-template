# Glue: web + api. Included into the server block by default.conf.template.
#
# The API, same-origin. WITHOUT this block /api/* falls through to the SPA
# fallback in default.conf.template and returns index.html with a 200 -- the frontend then fails
# with an opaque JSON parse error and the backend looks "unreachable" while
# being perfectly healthy. The shared Caddy proxies this whole vhost to one
# upstream (this container), so the split has to happen here.
#
# BACKEND_HOST is substituted at container start (see the entrypoint in the
# Dockerfile's prod stage) so that the compose project name, and therefore the
# backend's container name, is not baked into the image.
#
# The backend is looked up PER REQUEST, not once at start-up. A literal host in
# `proxy_pass` is resolved when nginx loads its config and the IP is kept for
# the life of the process -- so a deploy that recreates the backend (new
# container, new IP) and leaves this container running sends every /api
# request to the old address: 502 until someone restarts the frontend. Putting
# the host in a variable makes nginx ask Docker's embedded DNS (127.0.0.11)
# instead, and also lets nginx start while the backend is down.
location /api/ {
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $backend_upstream http://${BACKEND_HOST}:8000;
  # No URI part, so the original request URI is passed through unchanged --
  # the same as the literal form did.
  proxy_pass $backend_upstream;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # Long enough for a slow first query on a cold arm64 container.
  proxy_read_timeout 60s;
}
